{
  "name": "ドア年表 — instax 思い出マネージャー",
  "short_name": "ドア年表",
  "description": "家族の思い出を「年 × 月」の年表にして、instax mini / インクジェットで印刷し、テプラ用のラベルまで作るアプリ。",
  "id": "/doorthumbnail/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f7f5f1",
  "theme_color": "#f7f5f1",
  "lang": "ja",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "photos", "accept": ["image/jpeg", "image/png", "image/webp", "image/*"] }]
    }
  }
}
